{
  "name": "ecotrack-portal",
  "version": "1.0.0",
  "description": "EcoTrack - Smart Waste Management Portal (SIH25060)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server run start",
    "render:build": "npm run install:all && npm run build && npm run seed",
    "test": "npm --prefix server run test && npm --prefix client run test",
    "seed": "npm --prefix server run seed",
    "seed:reset": "npm --prefix server run seed:reset",
    "seed:mongo": "npm --prefix server run seed:mongo",
    "seed:mongo:reset": "npm --prefix server run seed:mongo:reset",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "waste-management",
    "sih2025",
    "civic-tech",
    "smart-city",
    "clean-india"
  ],
  "author": "EcoTrack Team",
  "license": "MIT"
}
